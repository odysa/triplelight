<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.triplelight</groupId>
  <artifactId>triplelight</artifactId>
  <version>0.1.0</version>
  <name>TripleLight for Java</name>
  <description>Embedded TripleLight RDF database for Java 25, through the Foreign Function and Memory API</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.13.4</junit.version>
    <!-- Override with -Dtriplelight.library=/path/to/libtriplelight_c.so to test against another build. -->
    <triplelight.library>${project.basedir}/../c/target/release/${native.lib}</triplelight.library>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
        <configuration>
          <!-- The native library is built from ../c; FFM downcalls need native access enabled. -->
          <argLine>--enable-native-access=ALL-UNNAMED -Dtriplelight.library=${triplelight.library}</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>mac</id>
      <activation><os><family>mac</family></os></activation>
      <properties><native.lib>libtriplelight_c.dylib</native.lib></properties>
    </profile>
    <profile>
      <id>unix</id>
      <activation><os><family>unix</family><name>Linux</name></os></activation>
      <properties><native.lib>libtriplelight_c.so</native.lib></properties>
    </profile>
  </profiles>
</project>
