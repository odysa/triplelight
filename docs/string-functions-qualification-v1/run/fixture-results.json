{
  "source": "https://www.w3.org/TR/sparql11-query/#func-strings",
  "cases": {
    "length-unicode": {
      "name": "length-unicode",
      "expression": "STRLEN(\"a\u03b2\")",
      "expected": {
        "type": "literal",
        "value": "2",
        "datatype": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "pass": true,
      "http_status": 200
    },
    "upper-tag": {
      "name": "upper-tag",
      "expression": "UCASE(\"foo\"@en)",
      "expected": {
        "type": "literal",
        "value": "FOO",
        "xml:lang": "en"
      },
      "pass": true,
      "http_status": 200
    },
    "lower-tag": {
      "name": "lower-tag",
      "expression": "LCASE(\"BAR\"@en)",
      "expected": {
        "type": "literal",
        "value": "bar",
        "xml:lang": "en"
      },
      "pass": true,
      "http_status": 200
    },
    "substring-unicode": {
