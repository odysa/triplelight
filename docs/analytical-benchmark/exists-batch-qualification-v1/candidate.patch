+fn distributive(p: &GraphPattern) -> bool {
+    match p {
+        GraphPattern::Bgp { .. } => true,
+        GraphPattern::Join { left, right } => distributive(left) && distributive(right),
+        GraphPattern::Filter { inner, expr } => distributive(inner) && !has_exists(expr),
+        _ => false,
+    }
+}
