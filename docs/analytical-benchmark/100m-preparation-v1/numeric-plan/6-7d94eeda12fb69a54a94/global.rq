PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/> PREFIX rev: <http://purl.org/stuff/rev#>
SELECT (COUNT(*) AS ?n) WHERE { ?product bsbm:producer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/dataFromProducer3166/Producer3166> . ?review bsbm:reviewFor ?product . { ?review bsbm:rating1 ?score } UNION { ?review bsbm:rating2 ?score } UNION { ?review bsbm:rating3 ?score } UNION { ?review bsbm:rating4 ?score } }