{
  "binary-service-enabled": "true",
  "cache-load-results": "false",
  "cache-max-num-entries": "1000",
  "cache-max-size": "1 MB",
  "cache-max-size-lazy-result": "1 MB",
  "cache-max-size-single-entry": "1 MB",
  "cache-service-results": "false",
  "construct-deduplication": "none",
  "default-query-timeout": "120s",
  "disable-caching": "true",
  "division-by-zero-is-undef": "true",
  "enable-distributive-union": "true",
  "enable-materialized-view-query-rewrite": "true",
  "enable-prefilter-on-index-scans": "true",
  "group-by-disable-index-scan-optimizations": "false",
  "group-by-hash-map-enabled": "false",
  "lazy-index-scan-max-size-materialization": "1000000",
  "lazy-index-scan-num-blocks-in-flight": "20",
  "log-level": "INFO",
  "materialized-view-pattern-match-num-assignments": "100000",
  "materialized-view-pattern-match-num-replacement-plans": "500",
  "materialized-view-writer-memory": "4 GB",
  "max-num-threads-per-query": "4",
  "memory-for-queries": "11 GB",
  "pattern-trick-num-tasks-in-flight": "3",
  "permutation-writer-num-blocks-in-flight": "4",
  "prefiltered-optional-join": "true",
  "query-planning-budget": "1500",
  "rebuild-index-max-num-threads": "0",
  "rebuild-max-concurrent-permutation-pairs": "0",
  "request-body-limit": "1 GB",
  "service-allowed-iri-prefixes": "",
  "service-max-binary-batch-size": "256 MB",
  "service-max-redirects": "1",
  "service-max-value-rows": "10000",
  "small-index-scan-size-estimate-divisor": "5",
  "sort-in-memory-threshold": "5 GB",
  "sort-num-tasks-in-flight": "3",
  "sparql-results-json-with-meta": "true",
  "spatial-join-max-num-threads": "8",
  "spatial-join-prefilter-max-size": "2500",
  "spatial-join-tmp-dir": "",
  "strip-columns": "true",
  "syntax-test-mode": "false",
  "throw-on-invalid-wkt": "false",
  "throw-on-unbound-variables": "false",
  "treat-default-graph-as-named-graph": "false",
  "use-binsearch-transitive-path": "true",
  "vacuum-minimum-block-size": "100",
  "websocket-update-interval": "50ms",
  "websocket-updates-enabled": "true",
  "zero-cost-estimate-for-cached-subtree": "false"
}