PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
SELECT ?product ?offerCount (EXISTS { ?offer bsbm:product ?product . ?offer bsbm:vendor ?vendor . ?vendor bsbm:country <http://downlode.org/rdf/iso-3166/countries#GB> } AS ?blocked)
WHERE { { SELECT ?product (COUNT(?offer) AS ?offerCount) { ?product a <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1282> . ?offer bsbm:product ?product } GROUP BY ?product } }