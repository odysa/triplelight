prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType37> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType370> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType371> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType372> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType373> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType374> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType375> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType376> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#AT> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
