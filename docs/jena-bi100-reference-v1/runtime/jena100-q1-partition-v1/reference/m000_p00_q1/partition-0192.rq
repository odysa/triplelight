prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType571> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType572> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType573> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType574> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType575> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType576> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType577> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType578> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#AT> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
