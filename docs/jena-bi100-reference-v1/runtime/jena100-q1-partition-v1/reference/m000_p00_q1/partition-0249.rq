prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType982> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType983> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType984> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType985> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType986> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType987> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType988> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType989> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#AT> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
