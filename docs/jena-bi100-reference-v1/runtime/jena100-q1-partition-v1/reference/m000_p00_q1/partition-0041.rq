prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1294> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1295> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1296> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1297> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1298> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1299> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType13> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType130> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#AT> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
