prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType889> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType89> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType890> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType891> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType892> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType893> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType894> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType895> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#AT> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
