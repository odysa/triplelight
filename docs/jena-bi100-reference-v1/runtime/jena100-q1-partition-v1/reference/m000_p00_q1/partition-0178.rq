prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType470> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType471> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType472> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType473> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType474> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType475> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType476> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType477> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#AT> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
