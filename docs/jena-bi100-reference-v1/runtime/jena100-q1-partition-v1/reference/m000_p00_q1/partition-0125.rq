prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType19> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType190> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1900> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1901> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1902> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1903> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1904> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1905> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#AT> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
