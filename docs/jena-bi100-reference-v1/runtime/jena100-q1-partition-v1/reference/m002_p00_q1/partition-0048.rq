prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1344> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1345> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1346> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1347> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1348> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1349> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType135> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1350> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
