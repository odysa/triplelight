prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType91> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType910> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType911> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType912> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType913> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType914> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType915> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType916> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
