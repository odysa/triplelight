prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1575> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1576> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1577> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1578> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1579> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType158> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1580> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1581> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
