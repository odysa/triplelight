prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1957> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1958> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1959> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType196> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1960> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1961> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1962> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1963> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
