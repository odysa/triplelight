prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1986> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1987> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1988> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1989> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType199> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1990> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1991> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1992> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
