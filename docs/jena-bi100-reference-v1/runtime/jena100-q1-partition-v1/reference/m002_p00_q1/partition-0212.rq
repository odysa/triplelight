prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType715> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType716> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType717> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType718> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType719> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType72> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType720> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType721> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
