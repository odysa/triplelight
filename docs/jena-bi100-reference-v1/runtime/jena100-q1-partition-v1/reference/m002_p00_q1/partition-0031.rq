prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1221> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1222> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1223> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1224> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1225> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1226> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1227> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1228> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
