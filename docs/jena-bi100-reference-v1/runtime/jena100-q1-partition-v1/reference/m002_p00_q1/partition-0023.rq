prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1164> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1165> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1166> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1167> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1168> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1169> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType117> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1170> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
