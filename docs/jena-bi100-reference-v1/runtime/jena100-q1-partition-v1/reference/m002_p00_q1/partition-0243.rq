prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType939> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType94> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType940> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType941> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType942> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType943> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType944> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType945> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
