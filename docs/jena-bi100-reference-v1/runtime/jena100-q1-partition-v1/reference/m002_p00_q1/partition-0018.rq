prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1128> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1129> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType113> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1130> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1131> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1132> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1133> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1134> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
