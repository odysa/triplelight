prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType355> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType356> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType357> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType358> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType359> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType36> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType360> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType361> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
