prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType412> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType413> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType414> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType415> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType416> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType417> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType418> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType419> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#US> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
