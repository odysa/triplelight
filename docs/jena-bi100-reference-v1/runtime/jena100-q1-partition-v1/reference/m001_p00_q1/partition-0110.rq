prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1791> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1792> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1793> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1794> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1795> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1796> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1797> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1798> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
