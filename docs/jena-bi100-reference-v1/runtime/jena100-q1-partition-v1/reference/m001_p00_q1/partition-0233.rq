prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType867> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType868> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType869> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType87> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType870> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType871> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType872> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType873> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
