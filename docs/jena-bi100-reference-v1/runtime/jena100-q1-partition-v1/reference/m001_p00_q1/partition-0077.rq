prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1553> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1554> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1555> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1556> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1557> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1558> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1559> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType156> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
