prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType120> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1200> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1201> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1202> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1203> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1204> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1205> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1206> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
