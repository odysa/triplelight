prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1056> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1057> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1058> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1059> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType106> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1060> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1061> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1062> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
