prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType643> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType644> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType645> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType646> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType647> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType648> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType649> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType65> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
