prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1560> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1561> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1562> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1563> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1564> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1565> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1566> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1567> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
