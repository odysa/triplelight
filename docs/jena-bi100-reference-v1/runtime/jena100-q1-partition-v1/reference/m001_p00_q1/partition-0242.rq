prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType931> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType932> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType933> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType934> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType935> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType936> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType937> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType938> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
