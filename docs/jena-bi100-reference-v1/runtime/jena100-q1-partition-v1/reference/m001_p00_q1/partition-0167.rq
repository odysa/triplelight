prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType391> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType392> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType393> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType394> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType395> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType396> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType397> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType398> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
