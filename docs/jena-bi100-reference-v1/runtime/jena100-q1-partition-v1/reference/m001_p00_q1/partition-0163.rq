prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType362> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType363> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType364> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType365> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType366> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType367> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType368> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType369> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
