prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType564> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType565> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType566> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType567> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType568> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType569> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType57> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType570> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#GB> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
