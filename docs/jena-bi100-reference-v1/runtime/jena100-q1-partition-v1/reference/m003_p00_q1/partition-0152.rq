prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType283> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType284> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType285> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType286> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType287> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType288> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType289> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType29> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#GB> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
