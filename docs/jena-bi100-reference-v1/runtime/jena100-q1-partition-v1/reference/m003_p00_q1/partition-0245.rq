prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType953> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType954> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType955> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType956> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType957> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType958> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType959> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType96> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#GB> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
