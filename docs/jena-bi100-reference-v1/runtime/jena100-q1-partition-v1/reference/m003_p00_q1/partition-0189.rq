prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType55> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType550> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType551> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType552> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType553> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType554> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType555> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType556> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#GB> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
