prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1827> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1828> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1829> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType183> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1830> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1831> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1832> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1833> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#GB> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
