prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1258> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1259> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType126> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1260> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1261> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1262> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1263> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1264> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#GB> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
