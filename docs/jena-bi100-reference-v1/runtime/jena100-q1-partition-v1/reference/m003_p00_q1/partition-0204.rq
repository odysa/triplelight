prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType658> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType659> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType66> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType660> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType661> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType662> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType663> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType664> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#GB> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
