prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType621> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType622> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType623> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType624> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType625> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType626> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType627> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType628> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#GB> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
