prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1502> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1503> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1504> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1505> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1506> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1507> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1508> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1509> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#GB> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
