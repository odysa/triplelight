prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
prefix rev: <http://purl.org/stuff/rev#>

Select ?productType ?reviewCount
{
 { Select ?productType (count(?review) As ?reviewCount)
  {
   ?productType a bsbm:ProductType .
 VALUES ?productType { <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1416> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1417> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1418> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1419> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType142> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1420> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1421> <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/ProductType1422> }
   ?product a ?productType .
   ?product bsbm:producer ?producer .
   ?producer bsbm:country <http://downlode.org/rdf/iso-3166/countries#JP> .
   ?review bsbm:reviewFor ?product .
   ?review rev:reviewer ?reviewer .
   ?reviewer bsbm:country <http://downlode.org/rdf/iso-3166/countries#GB> .
  }
  Group By ?productType
 }
}
Order By desc(?reviewCount) ?productType
Limit 10
