    "create": "CREATE TABLE triples(\n    s VARCHAR, p VARCHAR, o STRUCT(kind UTINYINT, value VARCHAR, datatype VARCHAR, lang VARCHAR)\n)",
    "create_view": "CREATE VIEW ontop_triples AS SELECT s, p, o.kind AS kind, o.value AS lexical, o.datatype AS datatype, o.lang AS lang FROM triples",
    "domains": "\nSELECT o.kind AS kind, o.datatype AS datatype, o.lang AS lang, count(*) AS rows\nFROM triples\nGROUP BY o.kind, o.datatype, o.lang\nORDER BY o.kind, o.datatype, o.lang\n",
    "insert": "INSERT INTO triples VALUES (\n    ?, ?, struct_pack(kind := ?::UTINYINT, value := ?::VARCHAR,\n                      datatype := ?::VARCHAR, lang := ?::VARCHAR)\n)",
