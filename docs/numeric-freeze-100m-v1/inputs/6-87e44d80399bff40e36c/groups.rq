PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/> PREFIX rev: <http://purl.org/stuff/rev#>
SELECT ?reviewer (COUNT(*) AS ?n) WHERE { ?product bsbm:producer <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/dataFromProducer1701/Producer1701> . ?review bsbm:reviewFor ?product . { ?review bsbm:rating1 ?score } UNION { ?review bsbm:rating2 ?score } UNION { ?review bsbm:rating3 ?score } UNION { ?review bsbm:rating4 ?score } ?review rev:reviewer ?reviewer } GROUP BY ?reviewer